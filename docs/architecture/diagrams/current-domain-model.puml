@startuml
title Current implemented Samvaad domain relationships

entity User {
  * userId : UUID
  --
  username
  email
  role
}

entity UserProfile {
  * userId : UUID
  --
  displayName
  bio
  avatarUrl
  firstName
  middleName
  lastName
  statusMessage
}

entity Session {
  * sessionId : UUID
  --
  userId
  refreshTokenHash
  expiresAt
  revokedAt
}

entity FriendRequest {
  * requestId : UUID
  --
  sender
  recipient
  status
  createdAt
  respondedAt
}

entity Conversation {
  * conversationId : UUID
  --
  participantMin
  participantMax
  lastSequenceNumber
}

entity E2eeMessage {
  * messageId : UUID
  --
  conversationId
  sender
  senderDeviceId
  sequence
  serverTimestamp
  requestId
}

entity E2eeEnvelope {
  * envelopeId : UUID
  --
  messageId
  recipientDeviceId
  envelopeType
  ciphertext
}

entity E2eeMailboxEntry {
  * entryId : UUID
  --
  recipientDeviceId
  messageId
}

entity E2eeSyncCursor {
  * cursorId : UUID
  --
  recipientDeviceId
  conversationId
  throughSequence
}

entity E2eeDevice {
  * deviceId : UUID
  --
  userId
  signalDeviceId
  status
}

User ||--o| UserProfile : has
User ||--o{ Session : owns
User ||--o{ FriendRequest : sends
User ||--o{ FriendRequest : receives
User ||--o{ Conversation : participates
Conversation ||--o{ E2eeMessage : contains
User ||--o{ E2eeMessage : sends
E2eeMessage ||--o{ E2eeEnvelope : addressedTo
E2eeMessage ||--o{ E2eeMailboxEntry : queuedFor
User ||--o{ E2eeDevice : owns

note right of FriendRequest
An ACCEPTED friend-request row is the friendship.
The internal areFriends(a,b) relationship check
is used by direct-message authorization.
end note

note right of Conversation
Exactly one direct conversation exists per
unordered participant pair at the database level.
Phase 4 creates it only on an authorized send.
end note

note right of E2eeMessage
requestId is unique for durable idempotency.
sequence is monotonic within a conversation.
serverTimestamp is assigned by the server.
end note

note right of E2eeEnvelope
Opaque per-recipient-device ciphertext.
The server never inspects it.
end note
@enduml
