<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        Samvaad operational file logging (see docs/development/logging.md):
        configuration-driven size-based rolling with compressed archives and
        bounded retention. Default retention target: 50 rolled files.
        File path, max size, and max history are configurable through
        application configuration (samvaad.logging.file.*).
    -->
    <springProperty scope="context" name="SAMVAAD_LOG_FILE" source="samvaad.logging.file.name" defaultValue="logs/samvaad.log"/>
    <springProperty scope="context" name="SAMVAAD_LOG_MAX_SIZE" source="samvaad.logging.file.max-size" defaultValue="10MB"/>
    <springProperty scope="context" name="SAMVAAD_LOG_MAX_HISTORY" source="samvaad.logging.file.max-history" defaultValue="50"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%X{traceId}] [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${SAMVAAD_LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>${SAMVAAD_LOG_FILE}.%i.gz</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>${SAMVAAD_LOG_MAX_HISTORY}</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>${SAMVAAD_LOG_MAX_SIZE}</maxFileSize>
        </triggeringPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%X{traceId}] [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
